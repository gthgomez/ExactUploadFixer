<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicitly disables Android 12+ (API 31+) cloud backup and device-to-device
    transfers. The app stores only a local onboarding flag — nothing user-facing
    should leave the device. Complements android:allowBackup="false" which already
    disables backup on older API levels.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
